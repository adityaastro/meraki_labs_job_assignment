# PDF Questions Extractor - Environment Configuration
# Copy this file to .env and fill in your values

# Required: OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Model Configuration
# MODEL_NAME=google/gemini-3-flash-preview
# MODEL_TEMPERATURE=0.1
# MODEL_MAX_TOKENS=65536

# Optional: Processing Configuration
# MAX_CONCURRENT_PDFS=5
# MAX_PAGES_FOR_NATIVE=30
# MAX_PAGES_PER_PDF=50
# IMAGE_DPI=300
# REQUEST_TIMEOUT=120

# Optional: Security - Base directory for PDF inputs (API only accepts paths within this dir)
# INPUT_BASE_DIR=/path/to/allowed/pdf/directory

# Optional: Resilience Configuration
# MAX_RETRIES=3
# RETRY_BACKOFF_BASE=2.0

# Optional: Cost Tracking
# COST_WARNING_THRESHOLD=0.10
# MODEL_COST_INPUT_1M=0.50
# MODEL_COST_OUTPUT_1M=3.00

# Optional: Logging
# LOG_LEVEL=INFO
